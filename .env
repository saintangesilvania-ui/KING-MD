# ──────────────────────────────
# 👑 KING-MD — Variables d'environnement
# Place ce fichier à la RACINE du projet (même dossier que index.js)
# Renomme-le en ".env" et remplis les valeurs
# ──────────────────────────────

# Port du serveur web (Railway/Render le fournissent automatiquement, optionnel en local)
PORT=8000

# Environnement Node (production réduit les logs)
NODE_ENV=production

# ── Session WhatsApp (reconnexion automatique sans repasser par le pairing) ──
# À remplir seulement après avoir pairé le bot une première fois
SESSION_ID=
SESSION_NUMBER=

# ── Numéro(s) propriétaire (accès admin total sur le bot) ──
# Format international sans le +, plusieurs numéros séparés par des virgules
OWNER_NUMBER=50933715832

# ── Intelligence artificielle (.ai, .translate, .summarize, .rewrite, .explain, .code, .bugfix) ──
# Obligatoire pour que les commandes IA fonctionnent
AI_API_KEY=
# Optionnel — par défaut OpenAI, change si tu utilises un autre fournisseur compatible
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# ── GitHub (utilisé par pair.js via Octokit, si tu stockes des sessions sur GitHub) ──
GITHUB_TOKEN=
